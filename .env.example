# ============================================================================
# Mostro Scripts — Configuración
# Copia este archivo como .env y edita los valores, o ejecuta ./admin/setup.sh
#
# Lo comentado son los valores por defecto: solo hace falta descomentar lo que
# difiera en tu instalación. Las variables de Telegram y Nostr sí son
# obligatorias si usas los bots.
# ============================================================================

# --- mostrod ---
#MOSTROD_SRC=/opt/mostro
#MOSTROD_CONFIG=/opt/mostro/settings.toml
#MOSTROD_BIN=/usr/local/bin/mostrod
#MOSTROD_SERVICE=mostro.service

# --- mostrix ---
#MOSTRIX_SRC=~/mostro-sources/mostrix
#MOSTRIX_CONFIG=~/.mostrix/settings.toml
#MOSTRIX_BIN=/usr/local/bin/mostrix

# --- mostro-watchdog ---
#WATCHDOG_SRC=~/mostro-sources/mostro-watchdog
#WATCHDOG_CONFIG=/opt/mostro/config.toml
#WATCHDOG_BIN=/usr/local/bin/mostro-watchdog
#WATCHDOG_SERVICE=mostro-watchdog.service

# --- Servicios propios ---
#BOT_SERVICE=mostrobot.service
#BOT_NOSTR_SERVICE=mostrobot-nostr.service
#ACCOUNTING_SERVICE=mostro-accounting.service
#SNAPSHOT_TIMER=mostro-snapshot.timer

# --- General ---
#BACKUP_DIR=~/mostro-sources/backups
#MOSTRO_LOG=                          # Vacío = journalctl

# Base real de mostrod. Solo la usa update.sh, para el respaldo previo a una
# actualización, y eso sí necesita sudo: el directorio es privado del usuario mostro.
#MOSTRO_DB=/opt/mostro/mostro.db

# Instantáneas de solo lectura que publica mostro-snapshot.timer. Es de donde leen
# TODAS las herramientas de consulta, sin sudo y sin privilegios. Ver el README.
#MOSTRO_DB_RO=/var/lib/mostro-snapshot/mostro.db
#MOSTRO_DISPUTES_DB_RO=/var/lib/mostro-snapshot/disputes.db

# --- Telegram: canal público de ofertas ---
# Aquí publica bot.py cada oferta nueva. Es un canal ABIERTO.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TEST_CHAT_ID=

# --- Mostro Nostr ---
MOSTRO_PUBKEY=
MOSTRO_RELAY=wss://relay.mostro.network

# --- Nostr Bot ---
#NOSTR_BOT_NSEC=              # Se genera automáticamente si está vacío
NOSTR_BOT_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.mostro.network

# --- Telegram: chat privado del operador ---
# Avisos de accounting.py (cada operación liquidada) y de monitor.sh.
TELEGRAM_MONITOR_TOKEN=
TELEGRAM_MONITOR_CHAT_ID=

# --- Telegram: resumen diario e informe mensual ---
# Destino de resumen.py e informe-mensual.py.
#
# SIN RESPALDO A PROPÓSITO: si TELEGRAM_STATS_CHAT_ID está vacío, no se envía
# nada. Antes caía a TELEGRAM_TEST_CHAT_ID, que apunta al canal PÚBLICO de
# ofertas — seguir aquel comportamiento publicaba en abierto las cuentas de la
# instancia. Si no sabes qué id poner, ejecuta bot/resolver-chat-id.py.
TELEGRAM_STATS_CHAT_ID=

# Bot propio para los informes. Si se deja vacío se usa TELEGRAM_TOKEN
# (o TELEGRAM_MONITOR_TOKEN en el informe mensual).
TELEGRAM_STATS_TOKEN=

# Origen alternativo de credenciales: lee bot_token y chat_id de la sección
# [telegram] de otro config.toml (p.ej. el del watchdog de Mostro). Si se
# define, tiene prioridad sobre TELEGRAM_STATS_TOKEN y TELEGRAM_STATS_CHAT_ID.
TELEGRAM_STATS_CONFIG=

# --- Web ---
# Repositorio de GitHub Pages donde premiums.sh escribe data/premiums.json.
#NOSTROMOSTRO_WEB_REPO=~/nostromostro.github.io
