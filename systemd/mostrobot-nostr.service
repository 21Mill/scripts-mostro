[Unit]
Description=NostroMostro Nostr Bot
After=network.target

[Service]
User=admin
Group=admin
WorkingDirectory=/home/admin/mostro-sources/scripts/bot
ExecStart=/usr/bin/python3 -u /home/admin/mostro-sources/scripts/bot/bot-nostr.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
